datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  cvUrl        String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id          String     @id @default(uuid())
  companyName String
  jobTitle    String
  status      String     @default("WAITING") // WAITING, INTERVIEWING, APPROVED, REJECTED
  priority    String     @default("MEDIUM")  // LOW, MEDIUM, HIGH
  location    String?    // e.g. Remote, Hybrid, San Francisco, CA
  salary      String?    // e.g. $120,000 - $140,000
  url         String?    // Link to job posting
  notes       String?    // Interview prep, contacts, notes
  tags        String?    // Comma-separated tags (e.g. "React, TypeScript, Remote")
  appliedAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  reminders   Reminder[]
}

model Reminder {
  id            String      @id @default(uuid())
  remindAt      DateTime
  message       String
  isSent        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
